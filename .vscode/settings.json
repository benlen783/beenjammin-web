{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    ".next": true,
    ".tools": true,
    "node_modules": true,
    "tsconfig.tsbuildinfo": true
  },
  "search.exclude": {
    ".next": true,
    ".tools": true,
    "node_modules": true
  }
}
